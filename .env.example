# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings > API). O .env.local nunca vai pro repositório.
# Sem estas variáveis o app roda só no modo demo (/p/demo e /p/single).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ignora o RLS: só no servidor, nunca com o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
